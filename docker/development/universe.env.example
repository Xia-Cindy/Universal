# Copy to docker/development/universe.env on the server. Do not commit it.
UNIVERSE_POSTGRES_DB=universe
UNIVERSE_POSTGRES_USER=universe
UNIVERSE_POSTGRES_PASSWORD=replace-with-a-long-random-secret
UNIVERSE_DEV_PORT=15180
# Set to 0.0.0.0 only when direct IP access is intended. The API and database
# stay internal to the Compose network.
UNIVERSE_BIND_ADDRESS=127.0.0.1

# RAGFlow is intentionally disabled for the first cloud-development stack.
# Configure it later in a separate, resource-reviewed deployment.
KNOWLEDGE_PROVIDER=local

# Optional shared AI Core configuration. Keep the API key only in the private
# server file; the browser never receives it. Base URL should include /v1.
# AI_PROVIDER=openai_compatible
# AI_OPENAI_BASE_URL=https://provider.example/v1
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=
# AI_OPENAI_TIMEOUT_SECONDS=45

# Enable only after universe-ragflow has passed cloud-preflight and an API key
# has been created in its UI. The API container reaches the private host port.
# KNOWLEDGE_PROVIDER=ragflow
# RAGFLOW_BASE_URL=http://host.docker.internal:19380
# RAGFLOW_API_KEY=
# RAGFLOW_DATASET_NAME=Universe OS Knowledge

# Optional build-only override if the cloud host cannot fetch Python wheels
# through the official index. Keep this unset on normal networks.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
