FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
# The JD Cloud host reaches the package index reliably while BuildKit's
# isolated build network can stall on the first Python wheel download. This
# affects this build step only; runtime ports remain Compose-managed loopback.
RUN --network=host pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend /app/backend
COPY database /app/database

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
