FROM node:22-alpine AS build

WORKDIR /app

COPY room-portfolio/package.json room-portfolio/package-lock.json ./
RUN npm ci

COPY room-portfolio ./
ARG VITE_ENABLE_LOCAL_SYLVA=false
ENV VITE_ENABLE_LOCAL_SYLVA=$VITE_ENABLE_LOCAL_SYLVA
RUN npm run build

FROM nginx:1.27-alpine

COPY docker/development/room.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
