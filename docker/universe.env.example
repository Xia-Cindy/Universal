# Copy to docker/universe.env. Do not commit the copied file.
UNIVERSE_POSTGRES_DB=universe
UNIVERSE_POSTGRES_USER=universe
UNIVERSE_POSTGRES_PASSWORD=replace-with-a-local-secret
UNIVERSE_POSTGRES_PORT=5432

# Load these before starting the FastAPI backend.
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://universe:replace-with-a-local-secret@127.0.0.1:5432/universe
