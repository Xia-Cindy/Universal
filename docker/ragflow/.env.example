# Universe OS local RAGFlow service configuration.
# Copy this file to docker/ragflow/.env before starting the stack.

# RAGFlow release image. Official Docker docs currently default to v0.26.4.
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4

# RAGFlow publishes x86 images. On Apple Silicon, Docker Desktop can emulate amd64,
# but startup and document parsing will be slower.
RAGFLOW_PLATFORM=linux/amd64

# Host ports exposed to the Mac.
RAGFLOW_WEB_PORT=8088
RAGFLOW_API_PORT=9380
RAGFLOW_ADMIN_PORT=9381

# Internal document engine. Elasticsearch is the default supported path.
# Infinity can be tested with the infinity profile, but is not supported on Linux/arm64.
DOC_ENGINE=elasticsearch
STACK_VERSION=8.11.3
MEM_LIMIT=8073741824

# Local-only defaults. Change all passwords before any shared or remote deployment.
MYSQL_IMAGE=mysql:8.0.40
REDIS_IMAGE=valkey/valkey:8
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.11.3
INFINITY_IMAGE=infiniflow/infinity:v0.7.0
INFINITY_PLATFORM=linux/amd64
ELASTIC_PASSWORD=infini_rag_flow
MYSQL_PASSWORD=infini_rag_flow
MYSQL_DATABASE=rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow
REDIS_PASSWORD=infini_rag_flow

# RAGFlow runtime settings.
REGISTER_ENABLED=1
TZ=Asia/Shanghai
MACOS=1
API_PROXY_SCHEME=python
ALLOW_ANY_HOST=0
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16

# Uncomment if model or parser downloads need a Hugging Face mirror.
# HF_ENDPOINT=https://hf-mirror.com
