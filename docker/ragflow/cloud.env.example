# Private cloud configuration for universe-ragflow. Copy to cloud.env on the
# server only, set mode 0600, and never commit it.
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
RAGFLOW_PLATFORM=linux/amd64
RAGFLOW_BIND_ADDRESS=127.0.0.1
RAGFLOW_WEB_PORT=18088
RAGFLOW_API_PORT=19380
RAGFLOW_ADMIN_PORT=19381

DOC_ENGINE=elasticsearch
STACK_VERSION=8.11.3
MEM_LIMIT=8589934592
MYSQL_IMAGE=mysql:8.0.40
REDIS_IMAGE=valkey/valkey:8
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.11.3

# Replace every value before start. Keep these values only in cloud.env.
ELASTIC_PASSWORD=replace-with-a-long-random-secret
MYSQL_PASSWORD=replace-with-a-long-random-secret
MYSQL_DATABASE=rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret

REGISTER_ENABLED=1
TZ=Asia/Shanghai
MACOS=0
API_PROXY_SCHEME=python
ALLOW_ANY_HOST=0
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
