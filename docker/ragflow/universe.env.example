# Copy this file to docker/ragflow/universe.env after RAGFlow is running.
# Fill RAGFLOW_API_KEY with an API key created in the RAGFlow UI.

KNOWLEDGE_PROVIDER=ragflow
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
RAGFLOW_DATASET_NAME=Universe OS Knowledge
# Local amd64-emulated RAGFlow can require more than the HTTP library default
# while cold-starting. This controls Universe's provider request timeout.
RAGFLOW_TIMEOUT_SECONDS=120
